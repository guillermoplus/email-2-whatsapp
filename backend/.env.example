# Servidor
PORT=3072
NODE_ENV=development

# Azure AD / registro de la aplicacion (todas obligatorias)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
# Debe terminar en /api/auth/outlook/login/callback y coincidir EXACTAMENTE con
# el Redirect URI registrado en Azure (App registrations > Authentication > Web).
# El servidor no arranca si no coincide.
AZURE_REDIRECT_URI=http://localhost:3072/api/auth/outlook/login/callback

# Outlook / OAuth2 (todas obligatorias)
OUTLOOK_AUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
OUTLOOK_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
OUTLOOK_SCOPE=Mail.Read offline_access IMAP.AccessAsUser.All User.Read.All

# WhatsApp (obligatorias)
# SEARCH_KEYWORD: texto que debe contener el correo a reenviar
SEARCH_KEYWORD=comprobante de pago
# WHATSAPP_PHONE_NUMBER: destino, con codigo de pais y sin simbolos
WHATSAPP_PHONE_NUMBER=573001112233
# WHATSAPP_MESSAGE: opcional; si se omite se genera un texto con el mes en curso
WHATSAPP_MESSAGE=

# Cron, zona horaria America/Bogota (ambas obligatorias)
CRON_REFRESH_OUTLOOK_TOKEN=0 0 * * *
CRON_SEND_ADMIN_PAYMENT_RECEIPT=0 59 11 5 * *

# Ruta al ejecutable de Chromium. Obligatoria en Docker (la imagen usa el
# Chromium de Alpine); en local se omite para que Puppeteer use el suyo.
PUPPETEER_EXECUTABLE_PATH=
